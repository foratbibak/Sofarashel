@using Sofarashel.Domain.Enums.User
@using Sofarashel.Domain.ViewModels.User
@model EditUserViewModel

@{
    ViewData["Title"] = "Edit";
}

@{
    ViewData["Title"] = "ویرایش کاربر ";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4">
        <i class="bx bx-user-plus me-1"></i>
        @ViewData["Title"]
    </h4>

    <div class="row g-4">
        @if (ViewBag.Error != null)
        {
            var error = (AdminEditUserResult)ViewBag.Error;
            switch (error)
            {
                case AdminEditUserResult.UserNameDuplicated:
                    {
                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                            <i class="bx bx-user-x me-2"></i>
                            <strong>نام کاربری تکراری!</strong> این نام کاربری قبلاً ثبت شده است. لطفاً نام کاربری دیگری انتخاب کنید.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                        break;
                    }

                case AdminEditUserResult.DatabaseError:
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bx bx-server me-2"></i>
                            <strong>خطای سرور!</strong> مشکلی در سرور رخ داده است. لطفاً چند دقیقه دیگر تلاش کنید یا با پشتیبانی تماس بگیرید.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                        break;
                    }
                case AdminEditUserResult.UnknownError:
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bx bx-help-circle me-2"></i>
                            <strong>خطای ناشناخته!</strong> خطایی رخ داده است. لطفاً با پشتیبانی تماس بگیرید. (کد: 5001)
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                        break;
                    }
            }
        }
        <form asp-action="Edit" class="row g-4" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <!-- ستون اصلی اطلاعات -->
            <div class="col-xl-8">
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-header bg-white border-bottom-0 pt-4">
                        <h5 class="mb-0">
                            <i class="bx bx-info-circle text-primary me-1"></i>
                            اطلاعات شخصی
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-semibold">
                                    <i class="bx bx-user text-muted me-1"></i>
                                    نام
                                </label>
                                <input asp-for="FirstName" class="form-control" placeholder="مثال: فرات" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-semibold">
                                    <i class="bx bx-user-voice text-muted me-1"></i>
                                    نام خانوادگی
                                </label>
                                <input asp-for="LastName" class="form-control" placeholder="مثال: بی باک" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UserName" class="form-label fw-semibold">
                                    <i class="bx bx-at text-muted me-1"></i>
                                    نام کاربری
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="bx bx-user"></i>
                                    </span>
                                    <input asp-for="UserName" class="form-control border-start-0" placeholder="alireza_123" />
                                </div>
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>
      
                 
                        </div>

                        <hr class="my-4" />

                        <div class="form-check form-switch">
                            <input class="form-check-input" asp-for="IsActive" type="checkbox" id="IsActive">
                            <label class="form-check-label fw-semibold" for="IsActive">
                                <i class="bx bx-check-circle text-success me-1"></i>
                                فعال بودن حساب کاربری
                            </label>
                            <div class="form-text ms-4">در صورت غیرفعال بودن، کاربر قادر به ورود نخواهد بود</div>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" asp-for="IsDelete" type="checkbox" id="IsDelete">
                            <label class="form-check-label fw-semibold" for="IsActive">
                                <i class="bx bx-check-circle text-success me-1"></i>
                                حذف بودن حساب کاربری
                            </label>
                            <div class="form-text ms-4">در صورت حذف بودن، کاربر قادر به ورود نخواهد بود</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ستون عکس و نقش‌ها -->
            <div class="col-xl-4">
                @if (Model.Roles != null && Model.Roles.Any())
                {
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="card-header bg-white border-bottom-0 pt-4">
                            <h5 class="mb-0">
                                <i class="bx bx-group text-primary me-1"></i>
                                نقش‌های کاربر
                            </h5>
                        </div>
                        <div class="card-body">
                            @foreach (var item in Model.Roles)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input" name="UserSelectedRoles" type="checkbox" value="@item.Id" @((Model.UserSelectedRoles.Any(r => r == item.Id) ? "checked" : ""))>
                                    <label class="form-check-label" for="role_@item.Id">
                                        <i class="bx bx-shield-alt text-info me-1"></i>
                                        @item.RoleName
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
            <!-- دکمه‌ها -->
            <div class="col-12">
                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bx bx-x me-1"></i>
                        انصراف
                    </a>
                    <button type="submit" class="btn btn-primary px-5">
                        <i class="bx bx-save me-1"></i>
                        ویرایش کاربر
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<style>
    .card {
        transition: all 0.3s ease;
    }

        .card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1) !important;
        }

    .form-control, .input-group-text {
        transition: all 0.2s ease;
    }

        .form-control:focus, .input-group:focus-within {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13,110,253,0.15);
        }

    .btn-primary {
        transition: all 0.2s ease;
    }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(13,110,253,0.3);
        }

    #imgAvatar {
        transition: all 0.3s ease;
    }

        #imgAvatar:hover {
            transform: scale(1.02);
            cursor: pointer;
        }

    .alert {
        border-radius: 12px;
        border: none;
    }

    .form-check-input:checked {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }
</style>