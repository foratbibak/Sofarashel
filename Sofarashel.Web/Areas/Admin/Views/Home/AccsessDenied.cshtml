<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>دسترسی غیرمجاز</title>
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Vazir Font -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/vazir-font@v30.1.0/dist/font-face.css" />
    <style>
        /* Reset & Full Page */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            min-height: 100vh;
            font-family: 'Vazir', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #0b1120; /* مشکی سرمه‌ای عمیق */
            color: #e8edf5;
            direction: rtl;
            overflow-x: hidden;
        }

        /* کانتینر اصلی - کل صفحه */
        .access-fullscreen {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            width: 100vw;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(ellipse at 30% 20%, #14223a 0%, #0a101f 70%, #050912 100%);
            padding: 24px;
            z-index: 9999;
        }

        /* المان‌های محتوا - بدون باکس و پنیر! */
        .content {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            max-width: 700px;
            width: 100%;
            animation: fadeScale 0.8s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
        }

        /* آیکون قفل بزرگ با افکت نئون */
        .lock-icon-wrapper {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: linear-gradient(145deg, #1a2a4a, #0d1a30);
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid rgba(59, 130, 246, 0.25);
            box-shadow: 0 0 50px rgba(37, 99, 235, 0.15), inset 0 0 60px rgba(37, 99, 235, 0.05);
            margin-bottom: 20px;
            transition: all 0.4s ease;
        }

            .lock-icon-wrapper:hover {
                border-color: rgba(59, 130, 246, 0.6);
                box-shadow: 0 0 80px rgba(37, 99, 235, 0.25), inset 0 0 80px rgba(37, 99, 235, 0.08);
                transform: scale(1.02);
            }

            .lock-icon-wrapper i {
                font-size: 64px;
                color: #3b82f6;
                filter: drop-shadow(0 0 20px rgba(59, 130, 246, 0.3));
                transition: all 0.3s ease;
            }

            .lock-icon-wrapper:hover i {
                filter: drop-shadow(0 0 35px rgba(59, 130, 246, 0.5));
                transform: scale(1.05);
            }

        /* عنوان اصلی */
        .content h1 {
            font-size: 44px;
            font-weight: 900;
            color: #ffffff;
            letter-spacing: -0.5px;
            margin-top: 8px;
            background: linear-gradient(135deg, #f0f4ff 0%, #90b4ff 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 0 60px rgba(59, 130, 246, 0.08);
        }

        /* توضیحات */
        .content .desc {
            font-size: 19px;
            line-height: 2.2;
            color: #b0c7e8;
            margin-top: 18px;
            max-width: 520px;
            font-weight: 300;
            letter-spacing: 0.2px;
        }

            .content .desc span {
                color: #6d8eff;
                font-weight: 500;
            }

        /* دکمه‌ها با استایل نئون/گلس */
        .actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
            gap: 20px;
            margin-top: 38px;
            width: 100%;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 16px 40px;
            border-radius: 60px;
            font-size: 17px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            border: none;
            cursor: pointer;
            min-width: 180px;
            flex: 1 0 auto;
            max-width: 260px;
            letter-spacing: 0.3px;
        }

        /* دکمه اصلی (آبی) */
        .btn-primary {
            background: linear-gradient(135deg, #1d4ed8, #3b82f6);
            color: #fff;
            box-shadow: 0 8px 32px -6px rgba(37, 99, 235, 0.4);
            border: 1px solid rgba(59, 130, 246, 0.2);
        }

            .btn-primary:hover {
                transform: translateY(-4px) scale(1.02);
                box-shadow: 0 16px 48px -8px rgba(37, 99, 235, 0.6);
                background: linear-gradient(135deg, #2563eb, #4f8cff);
                color: #fff;
            }

            .btn-primary:active {
                transform: scale(0.96);
            }

        /* دکمه دوم (شفاف با حاشیه) */
        .btn-outline {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            color: #c8dafc;
            border: 1.5px solid rgba(59, 130, 246, 0.25);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
        }

            .btn-outline:hover {
                background: rgba(59, 130, 246, 0.08);
                border-color: rgba(59, 130, 246, 0.6);
                transform: translateY(-4px);
                box-shadow: 0 12px 32px -8px rgba(37, 99, 235, 0.15);
                color: #ffffff;
            }

            .btn-outline:active {
                transform: scale(0.96);
            }

        .btn i {
            font-size: 22px;
            transition: transform 0.25s ease;
        }

        .btn-primary:hover i {
            transform: translateX(-5px);
        }

        .btn-outline:hover i {
            transform: translateX(-5px);
        }

        /* کد خطا - با استایل مینیمال */
        .error-code {
            margin-top: 40px;
            font-size: 15px;
            color: #5a7a9e;
            letter-spacing: 1px;
            font-weight: 300;
            padding: 8px 24px;
            border-radius: 40px;
            border: 1px solid rgba(59, 130, 246, 0.08);
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(4px);
        }

        /* خط تزئینی زیر دکمه‌ها (اختیاری) */
        .divider-line {
            width: 80px;
            height: 2px;
            background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.2), transparent);
            margin: 28px auto 0;
            border-radius: 4px;
        }

        /* انیمیشن ورود */
        @@keyframes fadeScale {
            0% {
                opacity: 0;
                transform: scale(0.92) translateY(30px);
            }

            100% {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        /* ذرات پس‌زمینه با افکت (دایره‌های محو) */
        .bg-glow {
            position: fixed;
            border-radius: 50%;
            pointer-events: none;
            z-index: 0;
            filter: blur(80px);
            opacity: 0.3;
        }

        .bg-glow-1 {
            width: 500px;
            height: 500px;
            background: #1d4ed8;
            top: -15%;
            left: -10%;
            opacity: 0.08;
        }

        .bg-glow-2 {
            width: 600px;
            height: 600px;
            background: #3b82f6;
            bottom: -20%;
            right: -10%;
            opacity: 0.06;
        }

        .bg-glow-3 {
            width: 300px;
            height: 300px;
            background: #60a5fa;
            top: 40%;
            right: 20%;
            opacity: 0.04;
            filter: blur(100px);
        }

        .content {
            position: relative;
            z-index: 2;
        }

        /* ریسپانسیو */
        @@media (max-width: 640px) {
            .lock-icon-wrapper {
                width: 110px;
                height: 110px;
            }

                .lock-icon-wrapper i {
                    font-size: 50px;
                }

            .content h1 {
                font-size: 32px;
            }

            .content .desc {
                font-size: 16px;
                line-height: 2;
                padding: 0 8px;
            }

            .actions {
                flex-direction: column;
                gap: 16px;
            }

            .btn {
                max-width: 300px;
                width: 100%;
                padding: 14px 24px;
                font-size: 15px;
                min-width: unset;
            }

            .error-code {
                font-size: 13px;
                padding: 6px 18px;
                margin-top: 32px;
            }

            .bg-glow-1 {
                width: 300px;
                height: 300px;
            }

            .bg-glow-2 {
                width: 350px;
                height: 350px;
            }
        }

        @@media (max-width: 400px) {
            .lock-icon-wrapper {
                width: 90px;
                height: 90px;
            }

                .lock-icon-wrapper i {
                    font-size: 40px;
                }

            .content h1 {
                font-size: 27px;
            }

            .content .desc {
                font-size: 14px;
                line-height: 1.9;
            }

            .btn {
                font-size: 14px;
                padding: 12px 18px;
            }

            .error-code {
                font-size: 12px;
                padding: 4px 14px;
            }
        }
    </style>
</head>
<body>

    <!-- افکت‌های پس‌زمینه (گلوس) -->
    <div class="bg-glow bg-glow-1"></div>
    <div class="bg-glow bg-glow-2"></div>
    <div class="bg-glow bg-glow-3"></div>

    <!-- صفحه کامل -->
    <div class="access-fullscreen">
        <div class="content">

            <!-- آیکون قفل با افکت نئونی -->
            <div class="lock-icon-wrapper">
                <i class="bi bi-lock-fill"></i>
            </div>

            <h1>دسترسی غیرمجاز</h1>

            <p class="desc">
                شما اجازه دسترسی به این بخش را ندارید.
                <br />
                برای ادامه، <span>وارد حساب کاربری</span> خود شوید یا به صفحه اصلی بازگردید.
            </p>

            <!-- دکمه‌ها -->
            <div class="actions">
                <a href="/" class="btn btn-primary">
                    <i class="bi bi-house-door-fill"></i>
                    صفحه اصلی
                </a>
                <a asp-controller="Account"
                   asp-action="Login"
                   asp-route-ReturnUrl="@ViewBag.ReturnUrl">
                    ورود
                </a>
            </div>

            <!-- خط تزئینی (اختیاری) -->
            <div class="divider-line"></div>

            <!-- کد خطا -->
            <div class="error-code">
                خطای ۴۰۳ · دسترسی ممنوع
            </div>

        </div>
    </div>

</body>
</html>